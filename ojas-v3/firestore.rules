rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null 
        && request.auth.uid == userId;
    }

    // Assessment results:
    // - Patients read/write only their own
    // - Practitioners can read results of linked patients
    match /assessmentResults/{resultId} {
      allow read, write: if request.auth != null 
        && request.auth.uid == resource.data.userId;
      
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.userId;
      
      // Practitioner read access (if patient is linked to them)
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/practitionerPatients/$(request.auth.uid)/patients/$(resource.data.patientId));
    }

    // Practitioner-patient links
    match /practitionerPatients/{pracId}/patients/{patientId} {
      allow read, write: if request.auth != null 
        && request.auth.uid == pracId;
    }

    // Practitioner notes — only the practitioner can read/write
    match /practitionerNotes/{pracId}/notes/{patientId} {
      allow read, write: if request.auth != null 
        && request.auth.uid == pracId;
    }
  }
}
